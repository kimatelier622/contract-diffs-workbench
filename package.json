{
  "name": "contract-diff-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode development",
    "dev:local": "vite --host 0.0.0.0 --mode development",
    "dev:uat": "vite --host 0.0.0.0 --mode uat",
    "build": "npm run build:prod",
    "build:local": "tsc -b && vite build --mode development",
    "build:uat": "tsc -b && vite build --mode uat",
    "build:prod": "tsc -b && vite build --mode prod",
    "preview": "vite preview --host 0.0.0.0 --mode prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "axios": "^1.7.7",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3",
    "@base-ui/react": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "@tailwindcss/vite": "^4.1.0"
  }
}
